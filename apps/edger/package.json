{
  "name": "@offgrid-ops-monorepo/edger",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "command": "bun build apps/edger/src/main.ts --outdir=apps/edger/dist --target=bun",
          "platform": "node",
          "outputPath": "apps/edger/dist",
          "format": [
            "cjs"
          ],
          "bundle": true,
          "main": "apps/edger/src/main.ts",
          "tsConfig": "apps/edger/tsconfig.app.json",
          "assets": [
            "apps/edger/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "build-outside": {
        "executor": "nx:run-commands",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "command": "bun build apps/edger/src/main.ts --outdir=dist/apps/edger --target=bun",
          "platform": "node",
          "outputPath": "apps/edger/dist",
          "format": [
            "cjs"
          ],
          "bundle": true,
          "main": "apps/edger/src/main.ts",
          "tsConfig": "apps/edger/tsconfig.app.json",
          "assets": [
            "apps/edger/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/edger/dist/package.json",
          "{workspaceRoot}/apps/edger/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/edger/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/edger/dist/patches",
          "{workspaceRoot}/apps/edger/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/edger/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "bun run --watch apps/edger/src/main.ts",
          "buildTarget": "@offgrid-ops-monorepo/edger:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@offgrid-ops-monorepo/edger:build:development"
          },
          "production": {
            "buildTarget": "@offgrid-ops-monorepo/edger:build:production"
          }
        }
      },
      "serve-dist": {
        "continuous": true,
        "executor": "nx:run-commands",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "bun run --watch apps/edger/dist/main.js",
          "buildTarget": "@offgrid-ops-monorepo/edger:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@offgrid-ops-monorepo/edger:build:development"
          },
          "production": {
            "buildTarget": "@offgrid-ops-monorepo/edger:build:production"
          }
        }
      }
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  },
  "dependencies": {
    "effect": "^3.22.2",
    "effector": "^23.4.4",
    "xstate": "^5.33.2"
  }
}
