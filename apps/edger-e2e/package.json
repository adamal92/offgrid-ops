{
  "name": "@offgrid-ops-monorepo/edger-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@offgrid-ops-monorepo/edger"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "@offgrid-ops-monorepo/edger:build",
          "@offgrid-ops-monorepo/edger:serve"
        ],
        "options": {
          "jestConfig": "apps/edger-e2e/jest.config.cts",
          "passWithNoTests": true
        }
      }
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3"
  }
}
