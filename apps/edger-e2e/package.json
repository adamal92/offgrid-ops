{
  "name": "@offgrid-ops-monorepo/edger-e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "implicitDependencies": [
      "@offgrid-ops-monorepo/edger"
    ],
    "targets": {
      "e2e": {
        "outputs": [
          "{projectRoot}/test-output/jest/coverage",
          "{workspaceRoot}\\coverage\\apps\\edger-e2e"
        ],
        "dependsOn": [
          "@offgrid-ops-monorepo/edger:build",
          "@offgrid-ops-monorepo/edger:serve"
        ],
        "options": {
          "passWithNoTests": true
        }
      },
      "bun-e2e": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun test apps/edger-e2e/src"
        }
      }
    },
    "// targets": "to see all targets run: nx show project @offgrid-ops-monorepo/edger-e2e --web"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3"
  }
}
